<Window x:Class="PhoneAudioConsole.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机音频控制台"
        Height="620" Width="580"
        MinHeight="520" MinWidth="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="手机音频接入控制台" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="常驻托盘；本窗口仅用于设置。" Foreground="#6B6B6B" Margin="0,4,0,14" />

            <Border Padding="12" CornerRadius="6" Background="#F4F5F7">
                <StackPanel>
                    <TextBlock Text="状态" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="等待手机接入" Margin="0,4,0,0" Foreground="#3A3A3A" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="连接方式" Margin="0,16,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ConnUsbRadio" Content="USB" Click="Connection_Click" />
                <RadioButton x:Name="ConnWifiRadio" Content="WiFi" Margin="20,0,0,0" Click="Connection_Click" />
                <RadioButton x:Name="ConnBluetoothRadio" Content="蓝牙" Margin="20,0,0,0" Click="Connection_Click" />
            </StackPanel>

            <TextBlock Text="抓取方式（USB / WiFi）" Margin="0,12,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ScopeAppRadio" Content="按应用（需 Android 13+，低版本自动整机）" Click="Scope_Click" />
                <RadioButton x:Name="ScopeDeviceRadio" Content="整机" Margin="20,0,0,0" Click="Scope_Click" />
            </StackPanel>

            <Button x:Name="MirrorButton" Content="开启息屏控制（scrcpy）" HorizontalAlignment="Left"
                    Margin="0,14,0,0" Padding="12,6" Click="Mirror_Click" />
            <TextBlock Text="手机屏幕熄灭，仍可在电脑上的 scrcpy 窗口里操作手机（需 USB/WiFi 已连接）"
                       Foreground="#8A8A8A" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            <CheckBox x:Name="MirrorKeepScreenCheck" Content="镜像时保持手机亮屏（更流畅，约 60→更高帧）"
                      Margin="0,8,0,0" Click="MirrorKeepScreen_Click" />

            <CheckBox x:Name="AutoTakeoverCheck" Content="接入后自动接管手机音频" Margin="0,12,0,0" Click="AutoTakeover_Click" />
            <CheckBox x:Name="MuteOnTakeoverCheck" Content="接管时把手机媒体音量置 0（拔出后保持静音）" Margin="0,8,0,0" Click="MuteOnTakeover_Click" />
            <CheckBox x:Name="SuppressExplorerCheck" Content="插入手机时不弹出资源管理器" Margin="0,8,0,0" Click="SuppressExplorer_Click" />

            <TextBlock Text="电脑播放设备" Margin="0,14,0,4" />
            <ComboBox x:Name="OutputDeviceCombo" SelectionChanged="OutputDevice_Changed" />

            <TextBlock Text="蓝牙设备（蓝牙接管时使用）" Margin="0,14,0,4" />
            <ComboBox x:Name="BluetoothDeviceCombo" SelectionChanged="BluetoothDevice_Changed" />

            <TextBlock Text="整机接收音量（整机接管时生效）" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="DeviceVolumeSlider" Grid.Column="0" Minimum="0" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="DeviceVolume_Changed" />
                <TextBlock x:Name="DeviceVolumeText" Grid.Column="1" Width="48" TextAlignment="Right"
                           VerticalAlignment="Center" Text="100%" />
            </Grid>

            <TextBlock Text="正在接管的手机应用" Margin="0,16,0,6" />
            <Border Padding="8" CornerRadius="6" Background="#F4F5F7" MinHeight="80">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AppListPanel">
                        <TextBlock x:Name="AppListEmpty" Text="暂无应用在播放" Foreground="#8A8A8A" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,16,0,0" Click="AutoStart_Click" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="关闭" Width="88"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click" />
    </DockPanel>
</Window>
